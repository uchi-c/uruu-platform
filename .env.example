# Database (runtime - pooled connection is fine here)
DATABASE_URL="postgresql://user:password@localhost:5432/uruu_db?schema=public"
# Database (migrations - must be a direct, non-pooled connection)
DIRECT_URL="postgresql://user:password@localhost:5432/uruu_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-next-auth-secret"

# JWT Secrets (Dual-secret configuration)
JWT_ACCESS_SECRET="your-access-secret"
JWT_REFRESH_SECRET="your-refresh-secret"

# AI Layer
CLAUDE_API_KEY="your-claude-api-key"
ML_SIDECAR_URL="http://localhost:8000"

# Multi-tenancy
DEFAULT_TENANT_ID="tenant-id-here"
