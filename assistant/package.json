{
  "name": "uruu-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Uruu — a local-first personal AI operating layer. Remembers, observes, acts.",
  "type": "module",
  "bin": {
    "uruu": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^5.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
